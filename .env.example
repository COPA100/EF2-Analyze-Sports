# Copy this file to `.env` and fill in your own Firebase web app config.
# Get these values from: Firebase Console -> Project Settings -> General ->
#                       Your apps -> SDK setup and configuration.
#
# All variables MUST be prefixed with VITE_ so Vite exposes them to the client.
# `.env` is git-ignored. Never commit real keys.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional — only needed if you enabled Google Analytics in your Firebase project.
VITE_FIREBASE_MEASUREMENT_ID=""
